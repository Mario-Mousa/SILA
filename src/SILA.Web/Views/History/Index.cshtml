@* ═══════════ HANDOFF ═══════════════════════════════════
   Task:        T3.4 | Owner: P4 | Status: DONE
   What exists: Status History audit log view displaying chronological transition events,
                actor references, from/to states, timestamps, and decision notes (BR-07, BR-08)
   What is left: none
   Depends on:  T1.1 (StatusHistory, StatusRecordType), T3.4 (StatusHistoryIndexViewModel)
   Used by:     All authenticated users via /History
   How to test: Visit /History; verify chronological entries, filtering by Type, and direct links to records
   Notes:       BR-08: Append-only ledger; entries are read-only and immutable
   ═══════════════════════════════════════════════════════ *@
@using SILA.Web.Models.Enums
@using SILA.Web.Models.ViewModels.History
@model StatusHistoryIndexViewModel
@{
    ViewData["Title"] = "Status History & Audit Log";
}

<div class="dashboard-shell py-2">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h3 fw-bold mb-0" style="color: var(--sila-forest);">Status History & Audit Log</h1>
                <span class="badge bg-secondary rounded-pill">BR-08 Immutable Ledger</span>
            </div>
            <p class="text-muted mb-0">Chronological audit trail of all status transitions and decisions across your requests and orders</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                &larr; Return to Dashboard
            </a>
            <a asp-controller="Dashboard" asp-action="Requests" class="btn btn-outline-primary btn-sm">
                Sent & Received Hub
            </a>
        </div>
    </div>

    <!-- Filter Buttons Toolbar -->
    <div class="card p-3 mb-4 border-0 shadow-sm bg-sand-light">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            <div class="d-flex align-items-center gap-2">
                <span class="fw-semibold small text-muted">Filter by Entity:</span>
                <div class="btn-group btn-group-sm" role="group" aria-label="Filter status history">
                    <a asp-action="Index" asp-route-filter="All"
                       class="btn @(Model.Filter == "All" ? "btn-primary" : "btn-outline-secondary")">
                        All Records (@Model.TotalCount)
                    </a>
                    <a asp-action="Index" asp-route-filter="Request"
                       class="btn @(Model.Filter == "Request" ? "btn-primary" : "btn-outline-secondary")">
                        Manufacturing Requests
                    </a>
                    <a asp-action="Index" asp-route-filter="Order"
                       class="btn @(Model.Filter == "Order" ? "btn-primary" : "btn-outline-secondary")">
                        Material Orders
                    </a>
                </div>
            </div>
            <small class="text-muted">Showing page @Model.CurrentPage of @(Model.TotalPages > 0 ? Model.TotalPages : 1)</small>
        </div>
    </div>

    <!-- Audit Log Table -->
    <div class="card border-0 shadow-sm overflow-hidden mb-4">
        <div class="card-body p-0">
            @if (!Model.Entries.Any())
            {
                <div class="text-center py-5 text-muted">
                    <span class="fs-1 d-block mb-2">📜</span>
                    <h2 class="h5 fw-bold mb-1">No status history records found</h2>
                    <p class="small mx-auto mb-0" style="max-width: 24rem;">
                        Status changes occur as requests and orders progress through their lifecycles.
                    </p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase text-muted">
                            <tr>
                                <th scope="col" style="min-width: 140px;">Entity Type</th>
                                <th scope="col" style="min-width: 200px;">Reference & Target</th>
                                <th scope="col" style="min-width: 220px;">Status Transition</th>
                                <th scope="col" style="min-width: 160px;">Changed By</th>
                                <th scope="col" style="min-width: 150px;">Timestamp</th>
                                <th scope="col" style="min-width: 200px;">Decision Note</th>
                                <th scope="col" class="text-end" style="min-width: 100px;">Link</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in Model.Entries)
                            {
                                <tr>
                                    <td>
                                        <span class="badge @(entry.RecordType == StatusRecordType.Request ? "bg-primary" : "bg-info")" style="font-size: 0.72rem;">
                                            @entry.RecordTypeLabel
                                        </span>
                                    </td>
                                    <td>
                                        <a href="@entry.DetailsUrl" class="fw-bold text-decoration-none text-dark d-block">
                                            @entry.RecordTitle
                                        </a>
                                        <small class="text-muted">@entry.CounterpartyName</small>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center gap-1 flex-wrap">
                                            <span class="status-badge small">@entry.FromStatus</span>
                                            <span class="text-muted">&rarr;</span>
                                            <partial name="_StatusBadge" model="entry.ToStatus" />
                                        </div>
                                    </td>
                                    <td>
                                        <span class="d-block small fw-semibold text-dark">@entry.ChangedByUserName</span>
                                    </td>
                                    <td>
                                        <span class="small text-muted d-block" title="@entry.ChangedAt.ToString("u")">
                                            @entry.ChangedAt.ToString("dd MMM yyyy HH:mm")
                                        </span>
                                        <small class="text-muted">@entry.TimeAgo</small>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(entry.Note))
                                        {
                                            <span class="small text-dark fst-italic">"@entry.Note"</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <a href="@entry.DetailsUrl" class="btn btn-sm btn-outline-secondary" title="View details">
                                            View &rarr;
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Pagination -->
    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Status history pagination">
            <ul class="pagination justify-content-center">
                <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage - 1)" asp-route-filter="@Model.Filter">Previous</a>
                </li>
                @for (int p = 1; p <= Model.TotalPages; p++)
                {
                    <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-filter="@Model.Filter">@p</a>
                    </li>
                }
                <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                    <a class="page-link" asp-action="Index" asp-route-page="@(Model.CurrentPage + 1)" asp-route-filter="@Model.Filter">Next</a>
                </li>
            </ul>
        </nav>
    }
</div>

