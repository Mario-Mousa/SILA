@* ═══════════ HANDOFF ═══════════════════════════════════
   Task:        T3.1 | Owner: P3 | Status: DONE
   What exists: Buyer & Public Raw Materials Browse view with keyword search, category filter, card grid, pagination, and empty state
   What is left: // TODO(T3.2): P1 wires direct "Place Material Order" CTA from catalog cards
   Depends on:  T1.1 (MaterialListing), T3.1 (IMaterialListingService, MaterialCatalogViewModel), T1.3 (_Pagination, _StatusBadge)
   Used by:     Public visitors, Brand Owners, Factory Owners browsing raw materials
   How to test: Visit /Materials/Browse; test keyword search, category dropdown, out-of-stock badge (BR-06), and pagination
   Notes:       BR-05: Only active listings from verified suppliers appear. BR-06: Out of stock at 0. D-08: Search & Category filter. D-10: EGP currency.
   ═══════════════════════════════════════════════════════ *@
@model SILA.Web.Models.ViewModels.Materials.MaterialCatalogViewModel
@{
    ViewData["Title"] = "Browse Raw Materials";
}

<!-- Page Header -->
<div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item active" aria-current="page">Browse Materials</li>
            </ol>
        </nav>
        <h1 class="h3 fw-bold mb-1" style="color: var(--sila-forest);">Browse Raw Materials</h1>
        <p class="text-muted mb-0">Browse fabrics, trims, yarns, and industrial textiles from verified Egyptian suppliers</p>
    </div>
    @if (User.IsInRole("Supplier"))
    {
        <div>
            <a asp-controller="Materials" asp-action="Manage" class="btn btn-outline-primary btn-sm">
                Manage My Listings &rarr;
            </a>
        </div>
    }
</div>

<!-- Search & Category Filter Bar (D-08) -->
<div class="card p-3 p-md-4 mb-4 border-0 shadow-sm bg-sand-light">
    <form method="get" asp-controller="Materials" asp-action="Browse" class="row g-3 align-items-end">
        <div class="col-12 col-md-6 col-lg-5">
            <label for="search" class="form-label small fw-semibold">Search Material or Supplier</label>
            <div class="input-group">
                <span class="input-group-text bg-white border-end-0">🔍</span>
                <input type="text" id="search" name="search" class="form-control border-start-0" 
                       placeholder="e.g. Cotton, Denim, Silk, Zipper, Nile Mills..." value="@Model.SearchTerm" />
            </div>
        </div>

        <div class="col-12 col-md-4 col-lg-4">
            <label for="category" class="form-label small fw-semibold">Category</label>
            <select id="category" name="category" class="form-select">
                <option value="">All Categories</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat" selected="@(string.Equals(Model.SelectedCategory, cat, StringComparison.OrdinalIgnoreCase))">@cat</option>
                }
            </select>
        </div>

        <div class="col-12 col-md-2 col-lg-3 d-flex gap-2">
            <button type="submit" class="btn btn-primary w-100">
                Filter
            </button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || !string.IsNullOrWhiteSpace(Model.SelectedCategory))
            {
                <a asp-controller="Materials" asp-action="Browse" class="btn btn-outline-secondary" title="Clear Filters">
                    Reset
                </a>
            }
        </div>
    </form>
</div>

<!-- Catalog Results -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <p class="text-muted small mb-0">
        Found <strong class="text-dark">@Model.TotalCount</strong> raw materials
        @if (!string.IsNullOrWhiteSpace(Model.SelectedCategory))
        {
            <span>in <strong class="text-dark">@Model.SelectedCategory</strong></span>
        }
        @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
        {
            <span>matching "<strong class="text-dark">@Model.SearchTerm</strong>"</span>
        }
    </p>
    <span class="badge bg-sand text-forest px-3 py-2 fw-semibold">Page @Model.CurrentPage of @Model.TotalPages</span>
</div>

@if (!Model.Listings.Any())
{
    <!-- Clean "No materials found" Empty State -->
    <div class="card p-5 text-center my-4 border-0 shadow-sm bg-sand-light">
        <div class="display-5 mb-3 text-muted">📦</div>
        <h3 class="h5 fw-bold" style="color: var(--sila-forest);">No Materials Found</h3>
        <p class="text-muted mb-4 mx-auto" style="max-width: 480px;">
            We couldn't find any verified raw materials matching your current search or category filter. Try clearing filters or using different keywords.
        </p>
        <div>
            <a asp-controller="Materials" asp-action="Browse" class="btn btn-outline-primary btn-sm">
                View All Materials
            </a>
        </div>
    </div>
}
else
{
    <!-- Material Cards Grid (12 items per page) -->
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4 mb-4">
        @foreach (var item in Model.Listings)
        {
            var isOutOfStock = item.AvailableQuantity <= 0;
            <div class="col">
                <div class="card h-100 border shadow-sm d-flex flex-column transition-hover">
                    <div class="card-body p-4 d-flex flex-column">
                        <!-- Top Metadata: Category & Stock Status -->
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge bg-sand text-forest fw-semibold">@item.Category</span>
                            @if (isOutOfStock)
                            {
                                <!-- BR-06: Out of Stock Badge -->
                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold">Out of Stock</span>
                            }
                            else
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle fw-semibold">In Stock</span>
                            }
                        </div>

                        <!-- Title -->
                        <h2 class="h6 card-title fw-bold mb-2">
                            <a asp-controller="Materials" asp-action="Details" asp-route-id="@item.Id" class="text-decoration-none" style="color: var(--sila-forest);">
                                @item.Name
                            </a>
                        </h2>

                        <!-- Supplier Name -->
                        <p class="text-muted small mb-2">
                            🏢 <strong>@(item.SupplierOrganization?.Name ?? "Verified Supplier")</strong>
                            @if (!string.IsNullOrWhiteSpace(item.SupplierOrganization?.City))
                            {
                                <span> • @item.SupplierOrganization.City</span>
                            }
                        </p>

                        <!-- Description Snippet -->
                        <p class="card-text text-muted small flex-grow-1 mb-3" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                            @(string.IsNullOrWhiteSpace(item.Description) ? "Quality Egyptian manufacturing raw material." : item.Description)
                        </p>

                        <!-- Specs & Pricing (D-10: EGP) -->
                        <div class="pt-3 border-top mt-auto">
                            <div class="d-flex justify-content-between align-items-baseline mb-2">
                                <span class="text-muted small">Unit Price:</span>
                                <span class="fw-bold fs-6" style="color: var(--sila-forest);">
                                    EGP @item.UnitPrice.ToString("N2") <small class="text-muted fw-normal">/@item.Unit</small>
                                </span>
                            </div>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-muted small">Available Stock:</span>
                                @if (isOutOfStock)
                                {
                                    <span class="badge bg-secondary-subtle text-muted">0 @item.Unit</span>
                                }
                                else
                                {
                                    <span class="small fw-semibold text-dark">@item.AvailableQuantity.ToString("N0") @item.Unit</span>
                                }
                            </div>

                            <!-- Action -->
                            <div class="d-grid">
                                <a asp-controller="Materials" asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">
                                    View Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @await Html.PartialAsync("_Pagination")
}
