@* ═══════════ HANDOFF ═══════════════════════════════════
   Task:        T2.3 | Owner: P3 | Status: DONE
   What exists: Responsive Supplier Dashboard shell with metric placeholders and quick actions
   What is left: // TODO(T3.4): P4 to bind live counts from MaterialListingService, MaterialOrderService, and NotificationService
   Depends on:  T1.1 (Organization, VerificationStatus), T1.3 (_StatusBadge, UI tokens)
   Used by:     Suppliers upon login
   How to test: Sign in as Supplier; navigate to /Dashboard; verify header, badges, metric cards, and quick actions
   Notes:       Follows wireframes.md lines 170-178; supports catalog management and incoming Material Orders
   ═══════════════════════════════════════════════════════ *@
@using SILA.Web.Models.Entities
@using SILA.Web.Models.Enums
@model Organization
@{
    ViewData["Title"] = "Supplier Dashboard";
    var orgName = Model?.Name ?? ViewBag.FullName ?? "Supplier Workspace";
    var isVerified = Model?.VerificationStatus == VerificationStatus.Verified;
}

<div class="dashboard-shell py-2">
    <!-- Header with Verification Status -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h3 fw-bold mb-0" style="color: var(--sila-forest);">@orgName</h1>
                @if (Model != null)
                {
                    <partial name="_StatusBadge" model="Model.VerificationStatus" />
                }
            </div>
            <p class="text-muted mb-0">Supplier Workspace · Publish raw materials, manage inventory, and fulfill buyer material orders</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-controller="Profile" asp-action="Index" class="btn btn-outline-secondary btn-sm">
                ⚙️ Supplier Profile
            </a>
            <a asp-controller="Materials" asp-action="Manage" class="btn btn-outline-primary btn-sm @(!isVerified ? "disabled" : "")">
                🧵 My Material Listings
            </a>
            <a asp-controller="Orders" asp-action="Index" class="btn btn-primary btn-sm">
                📦 Review Orders
            </a>
        </div>
    </div>

    @if (!isVerified)
    {
        <!-- Verification Notice Banner -->
        <div class="alert alert-warning d-flex align-items-center justify-content-between p-3 mb-4 rounded-3 shadow-sm" role="alert">
            <div class="d-flex align-items-center gap-3">
                <span class="fs-3">⚠️</span>
                <div>
                    <h2 class="h6 fw-bold mb-0">Commercial Verification Pending</h2>
                    <p class="small mb-0 text-muted">
                        Your supplier account is currently <strong>@(Model?.VerificationStatus.ToString() ?? "Unverified")</strong>. 
                        Publishing material listings and confirming orders requires administrative verification of your business documents.
                    </p>
                </div>
            </div>
            <a asp-controller="Profile" asp-action="Edit" class="btn btn-sm btn-outline-dark text-nowrap ms-3">
                Submit Documents &rarr;
            </a>
        </div>
    }

    <!-- Metric Cards Grid -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-4">
            <div class="card p-3 border-0 shadow-sm sila-metric-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">Active Material Listings</span>
                    <span class="metric-icon">🧵</span>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <span class="fs-2 fw-bold text-forest">0</span>
                    <span class="badge bg-sand text-muted small">Catalog</span>
                </div>
                <small class="text-muted mt-2 d-block">Published in public catalog</small>
            </div>
        </div>

        <div class="col-12 col-sm-4">
            <div class="card p-3 border-0 shadow-sm sila-metric-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">Orders to Review</span>
                    <span class="metric-icon">📥</span>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <span class="fs-2 fw-bold" style="color: var(--sila-clay);">0</span>
                    <span class="badge bg-sand text-muted small">PendingReview</span>
                </div>
                <small class="text-muted mt-2 d-block">Awaiting stock confirmation</small>
            </div>
        </div>

        <div class="col-12 col-sm-4">
            <div class="card p-3 border-0 shadow-sm sila-metric-card h-100">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted small fw-semibold">Confirmed Orders</span>
                    <span class="metric-icon">🚚</span>
                </div>
                <div class="d-flex align-items-baseline gap-2">
                    <span class="fs-2 fw-bold text-forest">0</span>
                    <span class="badge bg-sand text-muted small">Dispatched / Pending</span>
                </div>
                <small class="text-muted mt-2 d-block">Ready for dispatch or in delivery</small>
            </div>
        </div>
    </div>

    <!-- Quick Actions Row -->
    <div class="card p-3 mb-4 border-0 shadow-sm bg-sand-light">
        <div class="d-flex flex-wrap align-items-center justify-content-between gap-2">
            <span class="fw-semibold small text-muted">Catalog & Fulfillment:</span>
            <div class="d-flex flex-wrap gap-2">
                <a asp-controller="Materials" asp-action="Manage" class="btn btn-sm btn-primary @(!isVerified ? "disabled" : "")">
                    + Add New Material Listing
                </a>
                <a asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-outline-primary">
                    View Incoming Orders
                </a>
                <a asp-controller="Profile" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    Review Merchant Profile
                </a>
            </div>
        </div>
    </div>

    <!-- Activity Sections Grid -->
    <div class="row g-4">
        <!-- Incoming Material Orders Shell -->
        <div class="col-12 col-lg-8">
            <div class="card p-4 border-0 shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h6 fw-bold mb-0">Orders Needing Action</h2>
                    <a asp-controller="Orders" asp-action="Index" class="small text-decoration-none">View All Orders &rarr;</a>
                </div>
                <!-- Placeholder State -->
                <div class="text-center py-5 text-muted">
                    <span class="fs-1 d-block mb-2">📦</span>
                    <p class="mb-2 fw-semibold">No pending orders to review</p>
                    <p class="small mx-auto" style="max-width: 26rem;">
                        Buyers place orders directly from your active listings. When received, confirm stock to trigger atomic inventory deduction (BR-03).
                    </p>
                    <a asp-controller="Materials" asp-action="Manage" class="btn btn-sm btn-outline-primary mt-2 @(!isVerified ? "disabled" : "")">
                        Manage Listings Catalog
                    </a>
                </div>
            </div>
        </div>

        <!-- Inventory Alerts & Notifications Shell -->
        <div class="col-12 col-lg-4">
            <div class="card p-4 border-0 shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h2 class="h6 fw-bold mb-0">Low Stock Listings</h2>
                    <span class="badge bg-sand text-muted small">BR-06</span>
                </div>
                <!-- Placeholder State -->
                <div class="text-center py-4 text-muted border-bottom mb-3" style="border-color: var(--sila-line) !important;">
                    <span class="fs-2 d-block mb-1">📊</span>
                    <p class="small mb-0">All active listings have sufficient inventory</p>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-2">
                    <h2 class="h6 fw-bold mb-0">Latest Notifications</h2>
                    <a asp-controller="Notifications" asp-action="Index" class="small text-decoration-none">Inbox &rarr;</a>
                </div>
                <div class="text-center py-3 text-muted">
                    <span class="small">No new notifications</span>
                </div>
            </div>
        </div>
    </div>
</div>

