@using SILA.Web.Models.Enums
@model SILA.Web.Models.ViewModels.Profile.EditProfileViewModel
@{
    ViewData["Title"] = "Edit Profile";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-8 col-lg-7">
        <div class="card p-4 p-md-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="h3 fw-bold mb-0" style="color: var(--sila-forest);">Edit Organization Profile</h1>
                <span class="badge bg-secondary">@Model.Role</span>
            </div>

            <partial name="_ValidationSummary" />

            <form asp-action="Edit" method="post" enctype="multipart/form-data" novalidate>
                <input type="hidden" asp-for="OrganizationId" />
                <input type="hidden" asp-for="Role" />

                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="field-validation-error"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-12 col-md-6">
                        <label asp-for="City" class="form-label"></label>
                        <input asp-for="City" class="form-control" />
                        <span asp-validation-for="City" class="field-validation-error"></span>
                    </div>
                    <div class="col-12 col-md-6">
                        <label asp-for="ContactPhone" class="form-label"></label>
                        <input asp-for="ContactPhone" class="form-control" />
                        <span asp-validation-for="ContactPhone" class="field-validation-error"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3" placeholder="Brief overview of your business activities..."></textarea>
                    <span asp-validation-for="Description" class="field-validation-error"></span>
                </div>

                @if (Model.Role == OrganizationType.Brand)
                {
                    <div class="mb-3 p-3 border rounded bg-light">
                        <h6 class="fw-bold text-success mb-2">Brand Owner Verification Fields (Part 4.1)</h6>
                        
                        <div class="mb-3">
                            <label asp-for="InstagramUrl" class="form-label"></label>
                            <input asp-for="InstagramUrl" class="form-control" placeholder="https://instagram.com/your_brand" />
                            <span asp-validation-for="InstagramUrl" class="field-validation-error"></span>
                            <div class="form-text">Proof of brand ownership, active social presence or collection showcase.</div>
                        </div>

                        <div class="mb-0">
                            <label asp-for="PortfolioText" class="form-label"></label>
                            <textarea asp-for="PortfolioText" class="form-control" rows="3" placeholder="Describe your design aesthetic, previous collections, fabrics you work with..."></textarea>
                            <span asp-validation-for="PortfolioText" class="field-validation-error"></span>
                        </div>
                    </div>
                }
                else if (Model.Role == OrganizationType.Factory)
                {
                    <div class="mb-3 p-3 border rounded bg-light">
                        <h6 class="fw-bold text-success mb-2">Factory Verification Fields (Part 4.1)</h6>

                        <div class="mb-0">
                            <label asp-for="Address" class="form-label"></label>
                            <input asp-for="Address" class="form-control" placeholder="Industrial Zone, Building/Street, Governorate" />
                            <span asp-validation-for="Address" class="field-validation-error"></span>
                            <div class="form-text">Physical factory location and manufacturing workshop address.</div>
                        </div>
                    </div>
                }

                <div class="mb-4">
                    <label asp-for="LogoFile" class="form-label"></label>
                    <input asp-for="LogoFile" type="file" class="form-control" accept=".png,.jpg,.jpeg,.svg" />
                    <span asp-validation-for="LogoFile" class="field-validation-error"></span>
                    <div class="form-text">Optional organization logo (Max 2 MB).</div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                    <button type="submit" class="btn btn-primary">Save Profile Changes</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

