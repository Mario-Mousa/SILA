   Task:        T4.3 | Owner: P3 | Status: DONE
   What exists: Custom 500 / Server Error view matching SILA forest/sand theme with request tracking and recovery links
   What is left: none
   Depends on:  ErrorViewModel, SILA UI Tokens
   Used by:     HomeController.Error and unhandled exception pipeline
   How to test: Trigger error or visit /Home/Error; verify SILA forest/sand branding, requestId badge, and navigation buttons
   Notes:       SILA forest/sand design tokens, graceful recovery
   ═══════════════════════════════════════════════════════ *@
@model ErrorViewModel
@{
    ViewData["Title"] = "Error - SILA";
}

<div class="row justify-content-center py-4">
    <div class="col-12 col-md-8 col-lg-6">
        <div class="card p-4 p-md-5 text-center shadow-sm border">
            <!-- Error Icon Box -->
            <div class="mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 80px; height: 80px; background: #fff4f2; color: #b42318;">
                    <span class="fs-1" aria-hidden="true">⚠️</span>
                </div>
            </div>

            <!-- Error Heading -->
            <h1 class="h3 fw-bold mb-2 text-danger">Something went wrong</h1>
            <p class="text-muted mb-4">
                An unexpected server error occurred while processing your request. Please try again or return to the platform hub.
            </p>

            @if (Model?.ShowRequestId == true)
            {
                <div class="alert alert-light border text-start p-3 mb-4 mx-auto w-100" style="background-color: var(--sila-sand); border-color: var(--sila-line) !important;">
                    <div class="small fw-semibold text-muted mb-1">Diagnostic Tracking Reference:</div>
                    <code class="text-dark fw-bold small text-break">@Model.RequestId</code>
                </div>
            }

            <div class="alert alert-light border text-start p-3 mb-4" style="background-color: var(--sila-sand-light); border-color: var(--sila-line) !important;">
                <p class="mb-1 small fw-semibold text-forest">What can you do?</p>
                <ul class="mb-0 ps-3 small text-muted">
                    <li>Refresh the page to retry your last operation.</li>
                    <li>Check your internet connection or verify your session.</li>
                    <li>Return to your role dashboard to view pending workflows.</li>
                </ul>
            </div>

            <!-- Recovery Navigation Buttons -->
            <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                    Return to Home
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Dashboard" asp-action="Index" class="btn btn-outline-primary">
                        Go to Dashboard
                    </a>
                }
                <a asp-controller="Materials" asp-action="Index" class="btn btn-outline-secondary">
                    Browse Materials
                </a>
            </div>
        </div>
    </div>
</div>
