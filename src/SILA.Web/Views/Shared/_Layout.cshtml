@* HANDOFF | Task: T1.3 | Owner: P3 | Status: IN-PROGRESS
   What exists: Shared SILA shell with role-aware navigation and responsive content area.
   What is left: Bind unread notification count when T2.4 is available.
   Depends on: T1.2 (Identity roles), T2.3 (public/auth pages), T2.4 (notification count).
   Used by: T2.3, T3.1, T3.4, T4.3
   TODO(T2.4): Replace the notification bell placeholder with the unread count endpoint.
*@
@{
    var isAuthenticated = User?.Identity?.IsAuthenticated == true;
    var isAdmin = User?.IsInRole("Admin") == true;
    var isSupplier = User?.IsInRole("Supplier") == true;
    var isFactory = User?.IsInRole("Factory") == true;
    var isBrand = User?.IsInRole("Brand") == true;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#153d35" />
    <title>@ViewData["Title"] - SILA</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SILA.styles.css" asp-append-version="true" />
</head>
<body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
        <nav class="navbar navbar-expand-lg sila-nav" aria-label="Main navigation">
            <div class="container">
                <a class="navbar-brand sila-brand" asp-controller="Home" asp-action="Index" aria-label="SILA home"><span class="brand-mark" aria-hidden="true">ص</span><span>SILA</span></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavigation" aria-controls="mainNavigation" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
                <div class="collapse navbar-collapse" id="mainNavigation">
                    <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-1">
                        @if (isAuthenticated)
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                            @if (isBrand || isFactory)
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Materials" asp-action="Index">Materials</a></li>
                            }
                            @if (isSupplier)
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Materials" asp-action="Manage">My listings</a></li>
                            }
                            <li class="nav-item"><a class="nav-link" asp-controller="Requests" asp-action="Index">Requests</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Notifications" asp-action="Index">Notifications <partial name="_NotificationBell" /></a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Profile" asp-action="Index">Profile</a></li>
                            @if (isAdmin)
                            {
                                <li class="nav-item"><a class="nav-link" asp-controller="Admin" asp-action="Index">Verification review</a></li>
                            }
                            <li class="nav-item"><form asp-controller="Account" asp-action="Logout" method="post" class="d-inline"><button class="btn btn-outline-primary btn-sm ms-lg-2" type="submit">Sign out</button></form></li>
                        }
                        else
                        {
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Materials" asp-action="Index">Browse materials</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a></li>
                            <li class="nav-item"><a class="btn btn-primary btn-sm ms-lg-2" asp-controller="Account" asp-action="Register">Create account</a></li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <main id="main-content" class="container page-shell" role="main">
        @RenderBody()
    </main>
    <footer class="site-footer"><div class="container d-flex flex-wrap justify-content-between gap-2"><span>© 2026 SILA · Connecting Egypt’s fashion supply chain</span><a asp-controller="Home" asp-action="Privacy">Privacy</a></div></footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
