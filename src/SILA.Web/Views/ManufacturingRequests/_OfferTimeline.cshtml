@* ═══════════ HANDOFF ═══════════════════════════════════
   Task:        T4.3 | Owner: P3 | Status: DONE
   What exists: Chronological display of each Manufacturing Request offer round with responsive styling and date formatting
   What is left: none
   Depends on:  T1.1 (RequestOffer), T3.3 (OfferTimelineViewModel)
   Used by:     Views/ManufacturingRequests/Details.cshtml
   How to test: Open request details with counter-offers; verify chronological timeline steps and currency in EGP
   Notes:       D-10: EGP currency. Clean responsive margin and typography.
   ═══════════════════════════════════════════════════════ *@
@model IReadOnlyList<SILA.Web.Models.ViewModels.ManufacturingRequests.OfferTimelineViewModel>

@if (Model.Count == 0)
{
    <p class="text-muted mb-0">No offers have been recorded.</p>
}
else
{
    <ol class="list-unstyled mb-0">
        @foreach (var offer in Model)
        {
            <li class="border-start border-3 ps-3 pb-4 ms-2 position-relative">
                <span class="badge rounded-pill text-bg-light border mb-2">Round @offer.RoundNumber</span>
                <h3 class="h6 mb-1">@offer.ActorName offered EGP @offer.UnitPrice.ToString("N2") per unit</h3>
                <time class="small text-muted" datetime="@offer.CreatedAt.ToString("O")">@offer.CreatedAt.ToLocalTime().ToString("g")</time>
                @if (!string.IsNullOrWhiteSpace(offer.Note))
                {
                    <p class="mb-0 mt-2">@offer.Note</p>
                }
            </li>
        }
    </ol>
}
