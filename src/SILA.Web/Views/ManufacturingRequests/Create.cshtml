@* HANDOFF | Task: T3.3 | Owner: P2 | Status: DONE
   What exists: Brand Owner submission form for one Verified target factory.
   What is left: // TODO(T4.3): Check final copy, contrast and breakpoints.
   Depends on: T1.1 (request fields), T2.2 (verified factory directory), T1.3 (shared layout).
   Used by: ManufacturingRequestsController.Create.
*@
@model SILA.Web.Models.ViewModels.ManufacturingRequests.CreateManufacturingRequestViewModel
@{
    ViewData["Title"] = "New Manufacturing Request";
}

<div class="row justify-content-center">
    <div class="col-xl-9 col-lg-10">
        <div class="mb-4">
            <p class="text-uppercase small fw-semibold text-muted mb-1">Brand Owner</p>
            <h1 class="h2">New Manufacturing Request</h1>
            <p class="text-muted">Send your product details and offer to one Verified factory. The offer is per unit in EGP.</p>
        </div>

        <form asp-action="Create" method="post" class="card p-4 p-md-5" novalidate>
            <partial name="_ValidationSummary" />
            <div class="mb-3">
                <label asp-for="FactoryOrganizationId" class="form-label"></label>
                <select asp-for="FactoryOrganizationId" asp-items="Model.VerifiedFactories" class="form-select">
                    <option value="">Choose a Verified factory</option>
                </select>
                <span asp-validation-for="FactoryOrganizationId" class="field-validation-error"></span>
            </div>
            <div class="row g-3">
                <div class="col-md-8">
                    <label asp-for="ProductType" class="form-label"></label>
                    <input asp-for="ProductType" class="form-control" autocomplete="off" />
                    <span asp-validation-for="ProductType" class="field-validation-error"></span>
                </div>
                <div class="col-md-4">
                    <label asp-for="Quantity" class="form-label"></label>
                    <input asp-for="Quantity" class="form-control" min="1" step="1" inputmode="numeric" />
                    <span asp-validation-for="Quantity" class="field-validation-error"></span>
                </div>
                <div class="col-12">
                    <label asp-for="DesignSpecification" class="form-label"></label>
                    <textarea asp-for="DesignSpecification" class="form-control" rows="4" aria-describedby="design-help"></textarea>
                    <div id="design-help" class="form-text">Optional. Describe the cut, fit, colors, or include key measurements.</div>
                    <span asp-validation-for="DesignSpecification" class="field-validation-error"></span>
                </div>
                <div class="col-12">
                    <label asp-for="MaterialDescription" class="form-label"></label>
                    <textarea asp-for="MaterialDescription" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="MaterialDescription" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="InitialOfferPrice" class="form-label"></label>
                    <div class="input-group">
                        <input asp-for="InitialOfferPrice" class="form-control" min="0.01" step="0.01" inputmode="decimal" />
                        <span class="input-group-text">EGP / unit</span>
                    </div>
                    <span asp-validation-for="InitialOfferPrice" class="field-validation-error"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="AttachmentPath" class="form-label"></label>
                    <input asp-for="AttachmentPath" class="form-control" placeholder="https://… or stored file path" />
                    <span asp-validation-for="AttachmentPath" class="field-validation-error"></span>
                </div>
                <div class="col-12">
                    <label asp-for="Notes" class="form-label"></label>
                    <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Notes" class="field-validation-error"></span>
                </div>
            </div>
            <div class="d-flex flex-wrap gap-2 justify-content-end mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">Back</a>
                <button type="submit" class="btn btn-primary">Send Manufacturing Request</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
