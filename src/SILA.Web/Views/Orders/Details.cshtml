@* ═══════════ HANDOFF ═══════════════════════════════════
   Task:        T3.2 | Owner: P1 | Status: DONE
   What exists: Material Order details view with immutable line snapshots, price totals, status badges, history timeline, and role-based action controls
   What is left: // TODO(T3.4): Wire into unified Sent/Received requests and orders dashboard
   Depends on:  T1.1 (MaterialOrder, MaterialOrderLine, StatusHistory), T3.2 (OrdersController, OrderDetailsViewModel)
   Used by:     Brand, Factory, and Supplier organizations reviewing their orders
   How to test: Navigate to /Orders/Details/{id}; verify snapshot integrity after listing price edit (BR-04);
                Test Confirm (atomic stock deduction), Reject (with required reason), Dispatch, Deliver, and Cancel
   Notes:       BR-03: Atomic confirmation. BR-04: Snapshot display. BR-07: Record authorization. BR-08: StatusHistory timeline.
   ═══════════════════════════════════════════════════════ *@
@using SILA.Web.Models.ViewModels.Orders
@using SILA.Web.Models.Enums
@model OrderDetailsViewModel
@{
    ViewData["Title"] = $"Order #{Model.Order.Id} - Material Order";
}

<div class="container py-4">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Orders" asp-action="Index">Orders</a></li>
            <li class="breadcrumb-item active" aria-current="page">Order #@Model.Order.Id</li>
        </ol>
    </nav>

    <!-- Success & Error Alert Banners -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <strong>✓ Success:</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <strong>⚠️ Notice:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Order Header Bar -->
    <div class="card p-4 mb-4 border shadow-sm bg-sand-light">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h1 class="h3 fw-bold mb-0" style="color: var(--sila-forest);">Material Order #@Model.Order.Id</h1>
                    <partial name="_StatusBadge" model="Model.Order.Status" />
                </div>
                <div class="text-muted small">
                    Placed on <strong>@Model.Order.CreatedAt.ToString("dd MMM yyyy, HH:mm") UTC</strong>
                    @if (Model.Order.UpdatedAt.HasValue)
                    {
                        <span>· Last updated <strong>@Model.Order.UpdatedAt.Value.ToString("dd MMM yyyy, HH:mm") UTC</strong></span>
                    }
                </div>
            </div>

            <!-- Financial Total Header Pill -->
            <div class="text-md-end">
                <span class="text-muted small d-block">Order Total:</span>
                <span class="fs-4 fw-bold text-forest">@Model.Order.TotalAmount.ToString("N2") EGP</span>
            </div>
        </div>
    </div>

    <!-- Rejection Callout (if rejected) -->
    @if (Model.Order.Status == MaterialOrderStatus.Rejected && !string.IsNullOrWhiteSpace(Model.Order.RejectionReason))
    {
        <div class="alert alert-danger p-4 mb-4 border shadow-sm">
            <h5 class="alert-heading fw-bold mb-2">🚫 Order Rejected by Supplier</h5>
            <p class="mb-0"><strong>Rejection Reason:</strong> @Model.Order.RejectionReason</p>
        </div>
    }

    <div class="row g-4">
        <!-- Main Column: Order Line Items & History Timeline -->
        <div class="col-12 col-lg-8">
            <!-- Line Items Table (BR-04: Snapshots) -->
            <div class="card mb-4 shadow-sm border">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0" style="color: var(--sila-forest);">Order Items (Price & Item Snapshots)</h5>
                    <span class="badge bg-sand text-muted border">BR-04 Verified</span>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th scope="col">Material Name</th>
                                <th scope="col" class="text-center">Unit</th>
                                <th scope="col" class="text-end">Snapshot Price</th>
                                <th scope="col" class="text-center">Quantity</th>
                                <th scope="col" class="text-end">Line Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var line in Model.Order.Lines)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-semibold">@line.MaterialNameSnapshot</div>
                                        <small class="text-muted">Listing ID: #@line.MaterialListingId</small>
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border">@line.UnitSnapshot</span>
                                    </td>
                                    <td class="text-end font-monospace">
                                        @line.UnitPriceSnapshot.ToString("N2") EGP
                                    </td>
                                    <td class="text-center fw-bold">
                                        @line.Quantity
                                    </td>
                                    <td class="text-end fw-bold text-forest font-monospace">
                                        @line.LineTotal.ToString("N2") EGP
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="table-light border-top">
                            <tr>
                                <td colspan="4" class="text-end fw-bold">Total Order Amount:</td>
                                <td class="text-end fw-bold text-forest fs-5 font-monospace">
                                    @Model.Order.TotalAmount.ToString("N2") EGP
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>

            <!-- Status History Audit Trail Timeline (BR-08) -->
            <div class="card shadow-sm border">
                <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0" style="color: var(--sila-forest);">Order History & Audit Trail</h5>
                    <span class="badge bg-sand text-muted border">BR-08 Append-Only</span>
                </div>
                <div class="card-body p-4">
                    @if (Model.History != null && Model.History.Any())
                    {
                        <div class="timeline">
                            @foreach (var entry in Model.History)
                            {
                                <div class="d-flex mb-4 position-relative">
                                    <div class="me-3 text-center" style="width: 2rem;">
                                        <div class="rounded-circle bg-sand border d-flex align-items-center justify-content-center" style="width: 2rem; height: 2rem;">
                                            <span class="small">🕒</span>
                                        </div>
                                    </div>
                                    <div class="flex-grow-1 pb-3 border-bottom">
                                        <div class="d-flex justify-content-between align-items-baseline mb-1">
                                            <span class="fw-bold text-forest">
                                                @entry.FromStatus → @entry.ToStatus
                                            </span>
                                            <span class="text-muted small">
                                                @entry.ChangedAt.ToString("dd MMM yyyy, HH:mm") UTC
                                            </span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(entry.Note))
                                        {
                                            <div class="small text-muted mb-1">@entry.Note</div>
                                        }
                                        <div class="small text-muted" style="font-size: 0.8rem;">
                                            Changed by user: <code>@entry.ChangedByUserId</code>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0 small">No audit history entries recorded yet.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Sidebar Column: Organizations & Action Controls -->
        <div class="col-12 col-lg-4">
            <!-- Organization Profiles Card -->
            <div class="card p-4 mb-4 shadow-sm border bg-sand-light">
                <h5 class="fw-bold fs-6 mb-3" style="color: var(--sila-forest);">Parties Involved</h5>

                <!-- Buyer Info -->
                <div class="mb-3 pb-3 border-bottom">
                    <div class="text-muted small mb-1">Buyer Organization:</div>
                    <div class="fw-bold fs-6">@Model.Order.BuyerOrganization.Name</div>
                    <div class="small text-muted">@Model.Order.BuyerOrganization.Type · @Model.Order.BuyerOrganization.City</div>
                    <div class="small text-muted">📞 @Model.Order.BuyerOrganization.ContactPhone</div>
                </div>

                <!-- Supplier Info -->
                <div>
                    <div class="text-muted small mb-1">Supplier Organization:</div>
                    <div class="fw-bold fs-6">@Model.Order.SupplierOrganization.Name</div>
                    <div class="small text-muted">Supplier · @Model.Order.SupplierOrganization.City</div>
                    <div class="small text-muted">📞 @Model.Order.SupplierOrganization.ContactPhone</div>
                </div>
            </div>

            <!-- Workflow Action Controls Card -->
            <div class="card p-4 shadow-sm border">
                <h5 class="fw-bold fs-6 mb-3" style="color: var(--sila-forest);">Order Actions</h5>

                @if (Model.IsSupplier)
                {
                    @if (Model.CanConfirm)
                    {
                        <!-- Supplier: Confirm Order (BR-03) -->
                        <form asp-controller="Orders" asp-action="Confirm" asp-route-id="@Model.Order.Id" method="post" class="mb-3"
                              onsubmit="return confirm('Confirming this order will atomically deduct inventory from your stock (BR-03). Do you wish to proceed?');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary w-100 py-2">
                                ✓ Confirm Order (Deduct Stock)
                            </button>
                        </form>

                        <!-- Supplier: Reject Order (Triggers Modal) -->
                        <button type="button" class="btn btn-outline-danger w-100 py-2" data-bs-toggle="modal" data-bs-target="#rejectModal">
                            ✕ Reject Order
                        </button>
                    }
                    else if (Model.CanDispatch)
                    {
                        <!-- Supplier: Dispatch Order -->
                        <form asp-controller="Orders" asp-action="Dispatch" asp-route-id="@Model.Order.Id" method="post" class="mb-2">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-primary w-100 py-2">
                                🚚 Mark as Dispatched
                            </button>
                        </form>
                    }
                    else if (Model.CanDeliver)
                    {
                        <!-- Supplier: Deliver Order -->
                        <form asp-controller="Orders" asp-action="Deliver" asp-route-id="@Model.Order.Id" method="post" class="mb-2">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-success w-100 py-2">
                                📦 Mark as Delivered
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-secondary small mb-0">
                            ℹ️ No pending supplier actions for this order. Current status: <strong>@Model.Order.Status</strong>.
                        </div>
                    }
                }
                else if (Model.IsBuyer)
                {
                    @if (Model.CanCancel)
                    {
                        <!-- Buyer: Cancel Pending Order -->
                        <form asp-controller="Orders" asp-action="Cancel" asp-route-id="@Model.Order.Id" method="post"
                              onsubmit="return confirm('Are you sure you want to cancel this pending order? This action cannot be undone.');">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-outline-danger w-100 py-2">
                                ✕ Cancel Order
                            </button>
                        </form>
                    }
                    else if (Model.Order.Status == MaterialOrderStatus.Confirmed)
                    {
                        <div class="alert alert-info small mb-0">
                            ℹ️ Your order was confirmed by the supplier and stock was deducted. Confirmed orders cannot be cancelled in the system (Part 4.4).
                        </div>
                    }
                    else if (Model.Order.Status == MaterialOrderStatus.Dispatched)
                    {
                        <div class="alert alert-primary small mb-0">
                            🚚 Your order is currently in transit from the supplier.
                        </div>
                    }
                    else if (Model.Order.Status == MaterialOrderStatus.Delivered)
                    {
                        <div class="alert alert-success small mb-0">
                            ✓ Your order has been delivered successfully.
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-secondary small mb-0">
                            Current status: <strong>@Model.Order.Status</strong>.
                        </div>
                    }
                }
            </div>
        </div>
    </div>
</div>

<!-- Supplier Rejection Modal (Part 4.4: Reason Required) -->
@if (Model.CanReject)
{
    <div class="modal fade" id="rejectModal" tabindex="-1" aria-labelledby="rejectModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <form asp-controller="Orders" asp-action="Reject" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="OrderId" value="@Model.Order.Id" />

                    <div class="modal-header">
                        <h5 class="modal-title fw-bold" id="rejectModalLabel">Reject Material Order #@Model.Order.Id</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <p class="text-muted small">
                            A rejection reason note is required by SILA platform business rules (Part 4.4). The buyer will be notified with this reason.
                        </p>

                        <div class="mb-3">
                            <label for="rejectReason" class="form-label fw-semibold">Reason for Rejection <span class="text-danger">*</span></label>
                            <textarea id="rejectReason" name="Reason" class="form-control" rows="4" 
                                      maxlength="500" required placeholder="e.g. Current stock committed to other contracts, cannot fulfill requested delivery date..."></textarea>
                            <div class="form-text small">Maximum 500 characters.</div>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-danger">Confirm Rejection</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
