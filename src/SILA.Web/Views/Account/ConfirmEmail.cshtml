@{
    ViewData["Title"] = "Email Confirmation Status";
    var isSuccess = ViewBag.IsSuccess == true;
    var message = ViewBag.Message as string;
}

<div class="row justify-content-center">
    <div class="col-12 col-md-7 col-lg-6">
        <div class="card p-4 p-md-5 text-center">
            @if (isSuccess)
            {
                <div class="mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 72px; height: 72px; background: #ecfdf3; color: #027a48;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M13.854 3.646a.5.5 0 0 1 0 .708l-7 7a.5.5 0 0 1-.708 0l-3.5-3.5a.5.5 0 1 1 .708-.708L6.5 10.293l6.646-6.647a.5.5 0 0 1 .708 0z"/>
                        </svg>
                    </div>
                </div>

                <h1 class="h3 fw-bold mb-3" style="color: var(--sila-forest);">Email Verified!</h1>
                <p class="text-muted mb-3">@(message ?? "Your email has been confirmed successfully.")</p>
                
                <div class="alert alert-light border text-start p-3 mb-4 mx-auto" style="max-width: 440px; background-color: var(--sila-sand); border-color: var(--sila-line) !important;">
                    <div class="small text-muted">
                        <strong>Account Status: Unverified</strong><br />
                        Your account is now active. Sign in to browse the marketplace and submit your business verification documents for Admin review.
                    </div>
                </div>

                <div class="d-grid gap-2 col-sm-8 mx-auto">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg">Sign In to SILA</a>
                </div>
            }
            else
            {
                <div class="mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 72px; height: 72px; background: #fff4f2; color: #b42318;">
                        <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                            <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
                            <path d="M7.002 11a1 1 0 1 1 2 0 1 1 0 0 1-2 0zM7.1 4.995a.905.905 0 1 1 1.8 0l-.35 3.507a.552.552 0 0 1-1.1 0L7.1 4.995z"/>
                        </svg>
                    </div>
                </div>

                <h1 class="h3 fw-bold mb-3 text-danger">Verification Failed</h1>
                <p class="text-muted mb-4">@(message ?? "The email confirmation link is invalid or has expired.")</p>

                <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                    <a asp-controller="Account" asp-action="ResendConfirmationEmail" class="btn btn-primary">Request New Link</a>
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary">Back to Sign In</a>
                </div>
            }
        </div>
    </div>
</div>

