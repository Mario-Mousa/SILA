@* ═══════════ HANDOFF ═══════════════════════════════════
   Task:        T2.3 | Owner: P3 | Status: DONE
   What exists: Polished Sign-in view conforming to wireframes.md lines 88-98 with role badge and role switch option
   What is left: none
   Depends on:  T2.1 (AccountController.Login POST, LoginViewModel), T1.3 (UI guidelines)
   Used by:     Registered Brand Owners, Factory Owners, Suppliers, and Admins
   How to test: Visit /Account/Login, /Account/Login?role=Brand, /Account/Login?role=Factory; verify selected role banner and validation
   Notes:       Retains explicit role context if routed from /Home/RoleChoice
   ═══════════════════════════════════════════════════════ *@
@model SILA.Web.Models.ViewModels.Account.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    var returnUrl = ViewData["ReturnUrl"] as string;
    var infoMessage = TempData["InfoMessage"] as string;
    var selectedRole = Context.Request.Query["role"].ToString();
}

<div class="row justify-content-center py-2">
    <div class="col-12 col-md-6 col-lg-5">
        <div class="card p-4 p-md-5 border-0 shadow-sm">
            <div class="text-center mb-4">
                <span class="badge sila-eyebrow mb-2">SILA · Sign In</span>
                <div class="d-flex align-items-center justify-content-center gap-2 mb-1">
                    <h1 class="h3 fw-bold mb-0" style="color: var(--sila-forest);">Sign in to SILA</h1>
                    @if (!string.IsNullOrWhiteSpace(selectedRole))
                    {
                        <span class="badge bg-forest small">@selectedRole</span>
                    }
                </div>
                <p class="text-muted small">
                    @if (!string.IsNullOrWhiteSpace(selectedRole))
                    {
                        <span>Accessing @selectedRole workspace. <a asp-controller="Home" asp-action="RoleChoice" asp-route-actionType="Login" class="text-decoration-none">Change role</a></span>
                    }
                    else
                    {
                        <span>Enter your credentials to access your organization workspace</span>
                    }
                </p>
            </div>

            @if (!string.IsNullOrEmpty(infoMessage))
            {
                <div class="alert alert-info alert-dismissible fade show" role="alert">
                    @infoMessage
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <partial name="_ValidationSummary" />

            @if (ViewBag.ShowResendConfirmation == true)
            {
                <div class="alert alert-warning mb-4" role="alert">
                    <p class="mb-2 fw-semibold">Email confirmation is pending for <strong>@ViewBag.UnconfirmedEmail</strong>.</p>
                    <p class="mb-3 small">You cannot sign in until your email is confirmed. Did not receive the link?</p>
                    <form asp-controller="Account" asp-action="ResendConfirmationEmail" method="post" class="d-inline">
                        <input type="hidden" name="Email" value="@ViewBag.UnconfirmedEmail" />
                        <button type="submit" class="btn btn-outline-primary btn-sm">Resend Confirmation Email</button>
                    </form>
                </div>
            }

            <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@returnUrl" method="post" novalidate>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" autofocus />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <div class="mb-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <label asp-for="Password" class="form-label mb-0"></label>
                    </div>
                    <input asp-for="Password" class="form-control mt-1" />
                    <span asp-validation-for="Password" class="field-validation-error"></span>
                </div>

                <div class="form-check mb-4">
                    <input asp-for="RememberMe" class="form-check-input" />
                    <label asp-for="RememberMe" class="form-check-label text-muted"></label>
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-primary btn-lg shadow-sm">Sign In</button>
                </div>

                <div class="d-flex justify-content-between align-items-center small text-muted pt-2 border-top" style="border-color: var(--sila-line) !important;">
                    <span>New to SILA? <a asp-controller="Home" asp-action="RoleChoice" asp-route-actionType="Register">Create an account</a></span>
                    <a asp-controller="Account" asp-action="ResendConfirmationEmail">Resend verification</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
