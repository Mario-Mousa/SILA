@{
    ViewData["Title"] = "Confirm Your Email";
    var email = ViewBag.Email as string;
}

<div class="row justify-content-center">
    <div class="col-12 col-md-7 col-lg-6">
        <div class="card p-4 p-md-5 text-center">
            <div class="mb-4">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle" style="width: 72px; height: 72px; background: var(--sila-sand); color: var(--sila-forest);">
                    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" fill="currentColor" viewBox="0 0 16 16" aria-hidden="true">
                        <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2V4Zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1H2Zm13 2.383-4.708 2.825L15 11.105V5.383Zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741ZM1 11.105l4.708-2.897L1 5.383v5.722Z"/>
                    </svg>
                </div>
            </div>

            <h1 class="h3 fw-bold mb-3" style="color: var(--sila-forest);">Check Your Inbox</h1>
            
            <p class="text-muted mb-4">
                We sent a confirmation link to:
                <br />
                <strong class="text-dark fs-5">@(string.IsNullOrEmpty(email) ? "your registered email address" : email)</strong>
            </p>

            <div class="alert alert-light text-start border p-3 mb-4" style="background-color: var(--sila-sand); border-color: var(--sila-line) !important;">
                <h6 class="fw-bold mb-2">Next Steps:</h6>
                <ol class="mb-0 ps-3 small text-muted">
                    <li>Open the email from <strong>SILA Platform</strong>.</li>
                    <li>Click the <strong>Confirm Email Address</strong> button.</li>
                    <li>Once confirmed, sign in to submit your organization verification details (Part 4.1).</li>
                </ol>
            </div>

            <div class="d-flex flex-column flex-sm-row justify-content-center gap-2">
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary">Proceed to Sign In</a>
                <a asp-controller="Account" asp-action="ResendConfirmationEmail" class="btn btn-outline-primary">Resend Email</a>
            </div>
        </div>
    </div>
</div>

