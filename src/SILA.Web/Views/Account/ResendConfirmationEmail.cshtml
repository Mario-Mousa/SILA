@model SILA.Web.Models.ViewModels.Account.ResendConfirmationEmailViewModel
@{
    ViewData["Title"] = "Resend Confirmation Email";
}

<div class="row justify-content-center">
    <div class="col-12 col-md-6 col-lg-5">
        <div class="card p-4 p-md-5">
            <div class="text-center mb-4">
                <h1 class="h3 fw-bold" style="color: var(--sila-forest);">Resend Email Verification</h1>
                <p class="text-muted">Enter your registered email address and we'll send you a new confirmation link</p>
            </div>

            <partial name="_ValidationSummary" />

            <form asp-controller="Account" asp-action="ResendConfirmationEmail" method="post" novalidate>
                <div class="mb-4">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" type="email" class="form-control" placeholder="name@example.com" autofocus />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>

                <div class="d-grid mb-3">
                    <button type="submit" class="btn btn-primary btn-lg">Send Confirmation Link</button>
                </div>

                <div class="text-center text-muted small">
                    Remembered your credentials? <a asp-controller="Account" asp-action="Login">Back to Sign In</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

