@using SILA.Web.Models.Enums
@model SILA.Web.Models.ViewModels.Admin.AdminReviewViewModel
@{
    ViewData["Title"] = $"Review - {Model.Organization.Name}";
    var org = Model.Organization;
}

<div class="container py-2">
    <div class="mb-3">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
            &larr; Back to Verification Queue
        </a>
    </div>

    <div class="card p-4 mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 flex-wrap">
                    <h1 class="h3 fw-bold mb-0" style="color: var(--sila-forest);">@org.Name</h1>
                    <span class="badge bg-secondary">@org.Type</span>
                    <partial name="_StatusBadge" model="org.VerificationStatus" />
                </div>
                <p class="text-muted mb-0 small mt-1">
                    Owner: <strong>@(org.OwnerUser?.FullName ?? "N/A")</strong> (@(org.OwnerUser?.Email ?? "N/A")) · Phone: <strong>@org.ContactPhone</strong> · City: <strong>@org.City</strong>
                </p>
            </div>
            <div class="text-muted small">
                Submitted: @((org.UpdatedAt ?? org.CreatedAt).ToString("dd MMMM yyyy HH:mm"))
            </div>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <!-- Business Info -->
        <div class="col-12 col-lg-6">
            <div class="card p-4 h-100">
                <h2 class="h5 fw-bold mb-3" style="color: var(--sila-forest);">Business Profile Information</h2>

                <div class="mb-3">
                    <label class="form-label text-muted small mb-0">Description</label>
                    <p class="mb-0">@(string.IsNullOrWhiteSpace(org.Description) ? "No description provided." : org.Description)</p>
                </div>

                @if (org.Type == OrganizationType.Brand)
                {
                    <div class="mb-3 p-3 border rounded bg-light">
                        <h6 class="fw-bold mb-2">Brand Owner Proofs (Part 4.1 / D-12)</h6>
                        <label class="form-label text-muted small mb-0">Instagram / Social Link</label>
                        <p class="mb-2">
                            @if (!string.IsNullOrWhiteSpace(org.InstagramUrl))
                            {
                                <a href="@org.InstagramUrl" target="_blank" rel="noopener noreferrer" class="fw-bold">@org.InstagramUrl ↗</a>
                            }
                            else
                            {
                                <span class="text-danger small">No Instagram link provided.</span>
                            }
                        </p>

                        <label class="form-label text-muted small mb-0">Design Portfolio & Collections</label>
                        <p class="mb-0 small">@(string.IsNullOrWhiteSpace(org.PortfolioText) ? "No portfolio text provided." : org.PortfolioText)</p>
                    </div>
                }
                else if (org.Type == OrganizationType.Factory)
                {
                    <div class="mb-3 p-3 border rounded bg-light">
                        <h6 class="fw-bold mb-2">Factory Workshop Location (Part 4.1)</h6>
                        <label class="form-label text-muted small mb-0">Physical Address</label>
                        <p class="mb-0">@(string.IsNullOrWhiteSpace(org.Address) ? "No address provided." : org.Address)</p>
                    </div>
                }
            </div>
        </div>

        <!-- Verification Documents -->
        <div class="col-12 col-lg-6">
            <div class="card p-4 h-100">
                <h2 class="h5 fw-bold mb-3" style="color: var(--sila-forest);">Submitted Verification Documents</h2>

                @if (!Model.Documents.Any())
                {
                    <div class="alert alert-warning mb-0">
                        No documents were uploaded by this organization.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-bordered table-sm align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Document Type</th>
                                    <th>Upload Date</th>
                                    <th>File Preview</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var doc in Model.Documents)
                                {
                                    <tr>
                                        <td class="fw-semibold">@doc.DocumentType</td>
                                        <td class="small text-muted">@doc.UploadedAt.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>
                                            <a href="@doc.FilePath" target="_blank" class="btn btn-sm btn-outline-primary py-0 px-2">
                                                Open Document ↗
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Admin Decision Action Panel -->
    <div class="card p-4 border-2" style="border-color: var(--sila-line) !important; background-color: var(--sila-sand);">
        <h2 class="h5 fw-bold mb-2" style="color: var(--sila-forest);">Admin Verification Decision</h2>
        <p class="text-muted small mb-3">Choose whether to approve this organization into the SILA verified directory, or reject it with a feedback reason.</p>

        <partial name="_ValidationSummary" />

        <form asp-action="Decide" method="post">
            <input type="hidden" name="OrganizationId" value="@org.Id" />

            <div class="mb-3">
                <label class="form-label fw-bold">Feedback / Rejection Note</label>
                <textarea name="Note" class="form-control" rows="3" placeholder="If rejecting, provide a clear reason to the applicant (e.g. 'License document is expired', 'Instagram page cannot be verified'). Note is optional on approval.">@Model.Decision.Note</textarea>
                <span class="text-danger small">@Html.ValidationMessage("Decision.Note")</span>
            </div>

            <div class="d-flex gap-3 flex-wrap">
                <button type="submit" name="Action" value="Approve" class="btn btn-success px-4" onclick="return confirm('Are you sure you want to approve this organization as Verified?');">
                    ✓ Approve Organization (Set Verified)
                </button>

                <button type="submit" name="Action" value="Reject" class="btn btn-danger px-4" onclick="return confirm('Are you sure you want to reject this organization? Ensure you provided a rejection note.');">
                    ✕ Reject Organization
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

